// Toulouse Stalks · réglages Cloudflare
// public/ est servi tel quel ; src/worker.js répond aux adresses /api/.
{
  "name": "toulouse-stalks",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "PARTIES", "class_name": "Partie" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Partie"] }],
  // création : 20 parties par minute et par adresse ; toutes requêtes : 600 par minute
  "ratelimits": [
    { "name": "LIMITE_CREATION", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
    { "name": "LIMITE_API", "namespace_id": "2002", "simple": { "limit": 600, "period": 60 } }
  ],
  // adresse provisoire, neutre : le nom du jeu va sans doute changer
  "routes": [{ "pattern": "traque.okamimura.com", "custom_domain": true }],
  // l'adresse en workers.dev reste active en secours
  "workers_dev": true,
  "preview_urls": false
}
